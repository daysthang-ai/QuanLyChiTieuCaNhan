# FinTrack AI Configuration
PROJECT_NAME="FinTrack AI"
API_V1_STR="/api/v1"
SECRET_KEY="fintrack-ai-super-secret-jwt-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM="HS256"

# Database Configuration (SQLite default, PostgreSQL/MySQL ready)
DATABASE_URL="sqlite:///./fintrack.db"
# Example PostgreSQL: DATABASE_URL="postgresql://postgres:password@localhost:5432/fintrack_db"

# AI Provider Configuration
# Supported providers: gemini, openai, claude, ollama, smart_fallback
AI_PROVIDER="smart_fallback"

# Google Gemini API Key (Optional - get from https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI API Key (Optional - get from https://platform.openai.com/)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Local Ollama URL (Optional - e.g. http://localhost:11434)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Security & Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS="png,jpg,jpeg,webp,pdf"
